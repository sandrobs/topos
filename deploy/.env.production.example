# Copie para deploy/.env.production na VPS e preencha os campos vazios.
# Nunca use este exemplo diretamente nem versione o arquivo preenchido.
ASPNETCORE_ENVIRONMENT=Production
IMAGEM_APLICACAO=crm-ictm:producao
PORTA_HTTP=8080
POSTGRES_DB=crm_ictm
POSTGRES_USER=crm_ictm
POSTGRES_PASSWORD=
URL_PUBLICA=https://toposvisitantes.cnic1932.com.br
DOMINIO_GESTAO=toposgestao.cnic1932.com.br
DOMINIO_VISITA=toposvisitantes.cnic1932.com.br

# O bootstrap da API cria esta igreja somente se ainda não existir
# uma igreja com o mesmo nome, cidade e UF.
IGREJA_NOME=Igreja Evangélica de Cristo - Três de Maio
IGREJA_LOGRADOURO=Rua São Roque
IGREJA_NUMERO=88
IGREJA_BAIRRO=Por do Sol
IGREJA_COMPLEMENTO=
IGREJA_CEP=98910000
IGREJA_CIDADE=Três de Maio
IGREJA_ESTADO=RS

# Conta do aplicativo, não usuário de conexão do PostgreSQL.
ADMIN_NOME=Sandro
ADMIN_EMAIL=sandrobs@outlook.com
ADMIN_SENHA=

# Aviso utilizado no ambiente local; definir canal específico de contato
# para solicitações dos titulares antes de receber dados reais.
AVISO_PRIVACIDADE_VERSAO=2026-09-16-v1
AVISO_PRIVACIDADE_TEXTO=Esta igreja utiliza seu nome, WhatsApp e interesses somente para responder ao seu contato e acompanhar seu acolhimento. O acesso é restrito à equipe autorizada e aos administradores do sistema quando necessário para suporte. Não vendemos seus dados nem os usamos para publicidade. Adotamos medidas de segurança para proteger suas informações. Os dados serão mantidos pelo período necessário ao atendimento e às obrigações aplicáveis. Você pode solicitar acesso, correção, revogação do consentimento e, quando cabível, exclusão procurando a equipe da igreja. O contato pelo WhatsApp também está sujeito aos termos e políticas dessa plataforma. Menores de 18 anos devem ter seus dados enviados por um responsável legal.
